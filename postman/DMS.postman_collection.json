{
  "info": {
    "name": "DMS API",
    "description": "Document Management System API - Sprint 1 endpoints (Documents, Collections, Tags).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081",
      "type": "string"
    },
    {
      "key": "documentId",
      "value": "",
      "type": "string"
    },
    {
      "key": "collectionId",
      "value": "",
      "type": "string"
    },
    {
      "key": "tagId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Documents",
      "item": [
        {
          "name": "Upload document",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": [] },
                { "key": "description", "value": "Test document for Sprint 1", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/documents",
              "host": ["{{baseUrl}}"],
              "path": ["api", "documents"]
            }
          }
        },
        {
          "name": "List documents",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/documents",
              "host": ["{{baseUrl}}"],
              "path": ["api", "documents"]
            }
          }
        },
        {
          "name": "List documents (filtered by collection and tag)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/documents?collectionId={{collectionId}}&tagId={{tagId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "documents"],
              "query": [
                { "key": "collectionId", "value": "{{collectionId}}" },
                { "key": "tagId", "value": "{{tagId}}" }
              ]
            }
          }
        },
        {
          "name": "Get document by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/documents/{{documentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "documents", "{{documentId}}"]
            }
          }
        },
        {
          "name": "Download document file",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/documents/{{documentId}}/download",
              "host": ["{{baseUrl}}"],
              "path": ["api", "documents", "{{documentId}}", "download"]
            }
          }
        },
        {
          "name": "Update document (description and/or collections)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Updated description\",\n  \"collectionIds\": [\"{{collectionId}}\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/documents/{{documentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "documents", "{{documentId}}"]
            }
          }
        },
        {
          "name": "Delete document",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/documents/{{documentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "documents", "{{documentId}}"]
            }
          }
        },
        {
          "name": "Assign tag to document",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/documents/{{documentId}}/tags/{{tagId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "documents", "{{documentId}}", "tags", "{{tagId}}"]
            }
          }
        },
        {
          "name": "Remove tag from document",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/documents/{{documentId}}/tags/{{tagId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "documents", "{{documentId}}", "tags", "{{tagId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Collections",
      "item": [
        {
          "name": "Create collection",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Invoices\",\n  \"description\": \"All invoices\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/collections",
              "host": ["{{baseUrl}}"],
              "path": ["api", "collections"]
            }
          }
        },
        {
          "name": "List collections",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/collections",
              "host": ["{{baseUrl}}"],
              "path": ["api", "collections"]
            }
          }
        },
        {
          "name": "Get collection by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/collections/{{collectionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "collections", "{{collectionId}}"]
            }
          }
        },
        {
          "name": "Rename collection",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Receipts\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/collections/{{collectionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "collections", "{{collectionId}}"]
            }
          }
        },
        {
          "name": "Delete collection",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/collections/{{collectionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "collections", "{{collectionId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Tags",
      "item": [
        {
          "name": "Create tag",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"important\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tags",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tags"]
            }
          }
        },
        {
          "name": "List tags",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tags",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tags"]
            }
          }
        }
      ]
    }
  ]
}
